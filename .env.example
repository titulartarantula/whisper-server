# Hugging Face token with read access. Accept the terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1 with the same account first.
HF_TOKEN=

# 1 loads the diarization model at startup; 0 waits for the first request.
DIARIZATION_PRELOAD=0

# Seconds before an idle model is unloaded from the GPU; -1 keeps it loaded.
WHISPER_TTL=300
DIARIZATION_TTL=300
